# Postgres connection used by Prisma (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://manejoai:manejoai@localhost:5432/manejoai?schema=public"

# JWT signing secret for staff login - generate a real random value for production
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

PORT=3001

# Locks down CORS to this origin in production (e.g. your Netlify URL).
# Leave unset in local dev - Vite's proxy means there's no cross-origin
# request to restrict, and the app falls back to allowing any origin.
FRONTEND_URL=""

# Where job photos are stored. "local" writes to ./uploads on disk - fine for
# a single always-on server with a persistent disk, but NOT fine on Heroku/
# Railway/etc, where the filesystem is wiped on every restart or deploy.
# Use "s3" there (works for AWS S3 or Cloudflare R2 - same API).
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"

# Only used when STORAGE_DRIVER=s3:
S3_BUCKET=""
# Leave S3_ENDPOINT unset for real AWS S3. For Cloudflare R2:
# https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# The public base URL your bucket serves from (custom domain, R2's r2.dev
# URL, or an S3/CloudFront URL) - photo URLs are built as <this>/<key>.
S3_PUBLIC_URL_BASE=""

# Email provider for payment reminders. "console" just logs the email instead
# of sending it - safe default until a real provider is wired up.
MAIL_DRIVER="console"
# Must be an address on a domain you've verified with your mail provider - no
# provider can legitimately send "from" someone else's Gmail/Outlook/etc
# address (that's what SPF/DKIM/DMARC exist to prevent). A display name is
# recommended so customers see a recognizable name, not just the address:
MAIL_FROM="SCG Services LLC <billing@example.com>"
# Optional - replies land here instead of MAIL_FROM's inbox. Handy if you
# want to keep using an existing address (e.g. a Gmail account you already
# check) for replies while MAIL_FROM stays on your verified domain.
MAIL_REPLY_TO=""
# When MAIL_DRIVER=resend:
RESEND_API_KEY=""

# Days an invoice must be overdue before it starts appearing in the weekly
# reminder digest (see reminders.service.ts) - the "couple of weeks" grace
# period before the first nag. There's no separate follow-up interval to
# configure - the digest runs weekly, so a still-overdue invoice just shows
# up again in each week's email until it's paid or canceled.
REMINDER_GRACE_PERIOD_DAYS=14

# Kill switch for the automated daily-flagging/weekly-digest cron jobs (see
# reminders.service.ts). Defaults to off - set to "true" once real data is in
# and you're ready for the app to start emailing customers on its own. The
# manual "Send payment reminder" button and POST /api/reminders/run always
# work regardless of this setting.
REMINDERS_ENABLED="false"

# Business info is per-tenant now (see the Business model + POST /auth/register)
# - every business shows its own name/address/phone on its own invoices/emails,
# set once at registration. These vars only seed the *default* Business (the
# one every pre-existing User/Account was backfilled onto) via prisma/seed.ts
# - optional, prisma/seed.ts falls back to the same values if unset.
COMPANY_NAME="SCG SERVICES LLC"
COMPANY_ADDRESS_LINE1="131 Hillcrest Dr SW"
COMPANY_ADDRESS_LINE2="Austell, GA 30168-6737"
COMPANY_PHONE="404-507-4044"

# Telegram job-report intake - see src/telegram/. Per-business now (bot
# token, webhook secret, and linked group chat id all live on the Business
# row, set self-service from the app's Settings page - see
# TelegramSetupService). Nothing to configure here per business; this var
# is still global, since it's what TelegramSetupService uses to build every
# business's own webhook URL.
# Public HTTPS base URL the API is reachable at, used to register
# <this>/api/telegram/webhook/<businessId> with Telegram when a business
# saves their bot token. In production this is your Heroku/custom domain
# URL; for local testing it has to be a public tunnel URL (e.g. ngrok),
# since Telegram's servers can't reach localhost.
PUBLIC_API_URL=""

# Used by src/telegram/report-parsing.service.ts to turn worker messages
# into a suggested job title/description/property.
ANTHROPIC_API_KEY=""
