// manejoai data model
// Core idea: an Account is who you do business with. An Account can be a
// single "individual" customer, or a "multifamily" owner/management company
// that has several Properties and several Contacts with different roles
// (owner, sales, invoicing/AP). Jobs and Invoices always hang off an Account,
// and optionally point at one Property when the account has several.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy ----------

// One tenant of the app - its own name/address/phone (replaces what used to
// be the single hardcoded COMPANY config), its own users, and its own
// customers. Everything else (Job/Invoice/Quote/Payment/Property/Contact)
// belongs to a business transitively through Account.businessId - there's
// no need to duplicate the FK onto every table underneath it.
model Business {
  id           String   @id @default(cuid())
  name         String
  addressLine1 String
  addressLine2 String?
  phone        String?
  // The local part of this business's own sending address under the shared
  // manejoai.cloud domain (e.g. "n2sky" -> n2sky@manejoai.cloud) - lets every
  // business send invoices/reminders under its own recognizable address
  // without needing to verify its own domain in Resend. Generated once at
  // registration (see slugify() in auth.service.ts) and not editable after -
  // changing it would change what a business's customers see as the sender.
  emailSlug String @unique
  // Where replies to this business's emails should land - defaults to the
  // registering admin's own email, editable afterward in Settings since it
  // often isn't the same inbox as the login.
  replyToEmail String?

  // ---- Telegram job-report intake, configured per business in Settings ----
  // The bot token this business got from @BotFather - never sent back to the
  // frontend once saved (see BusinessesController), only used server-side.
  telegramBotToken String?
  // Fetched once via Telegram's getMe when the token is saved - shown in
  // Settings ("Bot: @your_bot") so a business can confirm it's the bot they
  // think it is.
  telegramBotUsername String?
  // Generated when telegramBotToken is saved, echoed back by Telegram on
  // every webhook call so TelegramWebhookGuard can verify it (see that
  // file) - one secret per business now that each has its own bot/webhook,
  // instead of the single TELEGRAM_WEBHOOK_SECRET env var this replaces.
  telegramWebhookSecret String?
  // Captured automatically from the first message this business's bot
  // receives (see TelegramService) - not something the business enters
  // directly, since Telegram group chat ids aren't user-facing.
  telegramGroupChatId String?
  telegramGroupTitle  String?
  // Self-reported via the "I've completed these steps" button in Settings -
  // Telegram gives no API to confirm privacy mode or group membership from
  // our side, so this is the business's own word that they did it.
  telegramConfirmedAt DateTime?

  // ---- Subscription billing (Stripe) ----
  // Mirrors Stripe's own subscription status strings directly (trialing,
  // active, past_due, canceled, incomplete, ...) - plain String rather than
  // an enum so a new Stripe status never needs a migration to handle. See
  // SubscriptionGuard for how this gates access.
  subscriptionStatus String @default("trialing")
  // "basic" (the $5 plan) or "pro" (the $25 plan, which adds the AI
  // assistant - see ProTierGuard). Default "pro" because a fresh business
  // starts on the Pro trial; the webhook flips it to "basic" only if they
  // actually subscribe to the Basic price. Also the grandfather value for
  // businesses that predate the tier split.
  subscriptionTier String @default("pro")
  // Set once at registration (now + TRIAL_PERIOD_DAYS) - independent of
  // Stripe, since no Customer/Subscription exists yet unless a business
  // subscribes early during the trial.
  trialEndsAt DateTime?
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  // For "renews on X" / "trial ends X" display - kept in sync from
  // customer.subscription.* webhooks.
  currentPeriodEnd DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users           User[]
  accounts        Account[]
  invoices        Invoice[]
  quotes          Quote[]
  incomingReports IncomingReport[]
}

// ---------- Staff / auth ----------

enum StaffRole {
  ADMIN // full access - e.g. the user who registered the business
  STAFF // office/admin staff: create invoices, log jobs, manage accounts
  // Platform-level, not tenant-level - sees aggregate stats/activity across
  // every business (see platform/), not any one business's own data. Still
  // belongs to a Business row (a User always does), but that's just a home
  // for the account, not a real tenant - see the "Manejoai Platform"
  // business created for this in scripts/create-superadmin.ts.
  SUPERADMIN
}

model User {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  name         String
  role         StaffRole @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  jobsCreated     Job[]     @relation("JobCreatedBy")
  invoicesCreated Invoice[] @relation("InvoiceCreatedBy")
  quotesCreated   Quote[]   @relation("QuoteCreatedBy")
  paymentsCreated Payment[] @relation("PaymentCreatedBy")
  reportsReviewed IncomingReport[] @relation("ReportReviewedBy")

  @@index([businessId])
}

// ---------- Customers ----------

enum AccountType {
  INDIVIDUAL // a regular one-off/residential customer
  MULTIFAMILY // a property owner / management company, can have many properties
}

model Account {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String // e.g. "Sunset Ridge Management LLC" or "Jane Smith"
  type       AccountType
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  properties Property[]
  contacts   Contact[]
  jobs       Job[]
  invoices   Invoice[]
  quotes     Quote[]
  payments   Payment[]

  @@index([businessId])
}

// A physical property belonging to an account. For an INDIVIDUAL account this
// is usually just their one address; for MULTIFAMILY accounts there can be many.
model Property {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name         String // e.g. "Sunset Ridge Apartments - Building C"
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs     Job[]
  invoices Invoice[]
  contacts Contact[]
  quotes   Quote[]
  matchedReports IncomingReport[]
}

enum ContactRole {
  OWNER
  SALES
  INVOICING // accounts payable / billing contact
  GENERAL
}

// A person at the account. A MULTIFAMILY account typically has one contact
// per role (owner, sales, AP); an INDIVIDUAL account usually just has GENERAL.
// A contact can optionally be scoped to one Property - a multifamily account
// often has a different owner/sales/AP contact per building rather than one
// set of contacts for the whole account. Leaving propertyId unset means the
// contact applies to the account as a whole (e.g. the parent company's AP
// contact).
model Contact {
  id        String      @id @default(cuid())
  accountId String
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  role  ContactRole
  name  String
  email String?
  phone String?

  // Who should get invoices / payment reminders for this account.
  receivesInvoices Boolean @default(false)
  receivesReminders Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Jobs (work performed) ----------

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model Job {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  title       String
  description String?
  status      JobStatus @default(SCHEDULED)
  scheduledAt DateTime?
  completedAt DateTime?

  createdById String
  createdBy   User   @relation("JobCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos   JobPhoto[]
  invoices Invoice[]
  quotes   Quote[]
  incomingReport IncomingReport?
}

model JobPhoto {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url       String // storage URL/key (see storage module)
  caption   String?
  createdAt DateTime @default(now())
}

// ---------- Quotes (pre-invoice proposals) ----------

enum QuoteStatus {
  PENDING // waiting on the customer's decision
  APPROVED // customer signed off - converted to an Invoice (see Quote.invoice)
}

// A quote is a proposed invoice: same shape (account/property/job + line
// items), but nothing is owed yet. Once approved, ApproveQuote copies its
// items onto a brand-new Invoice (quoteId is set on that Invoice via the
// inverse of this relation) and the quote itself becomes read-only history.
model Quote {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Denormalized copy of account.businessId, same reason as Invoice.businessId:
  // quoteNumber is unique per business, not globally, and a composite unique
  // constraint needs a real column on this table.
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id])

  quoteNumber String // e.g. "QUO-1001" - unique within a business, not globally (see @@unique below)
  // Always the sum of this quote's items - same rule as Invoice.amountCents.
  amountCents Int
  issueDate   DateTime    @default(now())
  status      QuoteStatus @default(PENDING)
  notes       String?

  approvedAt DateTime?
  // Set once approved. A quote converts to at most one invoice.
  invoiceId String?  @unique
  invoice   Invoice? @relation("QuoteToInvoice", fields: [invoiceId], references: [id])

  createdById String
  createdBy   User   @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]

  @@unique([businessId, quoteNumber])
}

// One line item on a quote - identical shape to InvoiceItem, copied over
// verbatim when the quote is approved.
model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  description    String
  quantity       Int @default(1)
  unitPriceCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Invoices ----------

enum InvoiceStatus {
  DRAFT
  SENT // invoice sent, not yet due
  AWAITING_PAYMENT // due date passed very recently / grace period
  OVERDUE // past the grace period, reminders active
  PAID
  CANCELED
}

model Invoice {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Denormalized copy of account.businessId, set once at creation and never
  // changed after (an invoice's account never moves to a different
  // business) - needed so invoiceNumber can be unique per business instead
  // of one shared global sequence. Every other business-scoped table stays
  // scoped transitively through accountId; this is the one exception,
  // purely because Prisma/Postgres composite unique constraints need real
  // columns on the same table.
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id])

  invoiceNumber String // e.g. "10042" - unique within a business, not globally (see @@unique below)
  // Always the sum of this invoice's items (quantity * unitPriceCents),
  // recomputed server-side whenever an item is added/changed/removed - never
  // set directly. Kept as a real column so listing/sorting by amount doesn't
  // need to join+sum every time.
  amountCents   Int
  issueDate     DateTime @default(now())
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  // What the customer sees as this invoice's title, e.g. "Unit 731L Resurface
  // 1 vanity bathroom sink" - required on create (the DTO enforces this;
  // every historical/imported invoice already has one, hence NOT NULL here).
  title         String

  paidAt     DateTime?
  canceledAt DateTime?
  // Set when this invoice was paid as part of a batch/recorded Payment
  // (see Payment below) - null for invoices paid before that existed, or
  // marked paid some other way.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdById String
  createdBy   User   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders ReminderLog[]
  items     InvoiceItem[]
  quote     Quote? @relation("QuoteToInvoice")

  @@unique([businessId, invoiceNumber])
  @@index([status])
  @@index([dueDate])
}

// A record of money actually received - one payment can cover several
// invoices at once (e.g. a customer settles 3 invoices with one check), so
// this is the durable "record" of that event for bookkeeping/statistics,
// separate from the invoices' own PAID status. All invoices in a payment
// belong to the same account (see PaymentsService.record).
model Payment {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  paidAt      DateTime // the date the payment was actually received (may be backdated)
  // Sum of the covered invoices' amountCents at the moment this payment was
  // recorded - a snapshot, not recomputed if an invoice later changes.
  amountCents Int
  notes       String?

  createdById String
  createdBy   User   @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  invoices Invoice[]

  @@index([accountId])
  @@index([paidAt])
}

// One line item on an invoice, e.g. "Interior paint - Unit 101" x2 @ $150.
// lineTotalCents (quantity * unitPriceCents) isn't stored - it's cheap to
// compute on read, and storing it risks drifting from quantity/unitPriceCents.
model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description    String
  quantity       Int @default(1)
  unitPriceCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Telegram job-report intake ----------

enum ReportStatus {
  PENDING // captured, not yet reviewed
  CONVERTED // staff approved - became a real Job
  DISMISSED // staff rejected (spam, unrelated chat, duplicate, etc.)
}

// A worker's report (text + photos) posted in the Telegram job-reports
// group, captured here before it becomes a real Job - a Job always needs a
// resolved accountId, and a chat message can't reliably provide one, so
// this is where AI-parsed guesses live until a human confirms them.
model IncomingReport {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source     String   @default("telegram")

  senderName String? // Telegram display name - free text, no worker accounts yet
  rawText    String? // concatenated text from the message burst
  photoUrls  String[] // already-uploaded R2 URLs

  // Claude's best-effort extraction - always shown to staff, never auto-trusted
  suggestedTitle        String?
  suggestedDescription  String?
  suggestedPropertyText String? // raw property name text Claude read, e.g. "bldg C"

  // Server-side match of suggestedPropertyText against real Property names.
  // The account always comes from matchedProperty.accountId, never set
  // independently, so the two can't disagree.
  matchedPropertyId String?
  matchedProperty   Property? @relation(fields: [matchedPropertyId], references: [id])

  status ReportStatus @default(PENDING)
  jobId  String?      @unique
  job    Job?         @relation(fields: [jobId], references: [id])

  receivedAt   DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("ReportReviewedBy", fields: [reviewedById], references: [id])

  @@index([businessId])
}

// One row per reminder email actually sent, so the scheduler never double-sends
// and so staff can see the follow-up history on an invoice.
model ReminderLog {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentAt    DateTime @default(now())
  toEmail   String
  subject   String
}
