{
  "expo": {
    "name": "manejoai",
    "slug": "manejoai-mobile",
    "scheme": "manejoai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.manejoai.app"
    },
    "android": {
      "package": "cloud.manejoai.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "manejoai uses your photo library so you can attach job photos to a job.",
          "cameraPermission": "manejoai uses your camera so you can photograph a job as you finish it."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "df5047ba-d399-41ff-a4a4-2ac42d89fc8e"
      }
    },
    "owner": "damiancanelles"
  }
}
